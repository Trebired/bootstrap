{
  "name": "@trebired/bootstrap",
  "version": "1.2.9",
  "description": "Generic application lifecycle orchestrator with ordered bootstrap discovery, readiness control, graceful degradation, and shutdown.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs prepare-dist",
    "demo": "bun run examples/dummy.ts",
    "postpack": "bun ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && bun ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:runtime && bun run verify:pack",
    "prepare:generated": "bun ./scripts/build/generated/tsconfig.mjs",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:runtime": "bun ./scripts/verify/runtime.mjs",
    "verify:pack": "bun ./scripts/verify/pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.2.12",
    "@package/result": "npm:@trebired/result@^1.1.6"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^6.0.9",
    "@trebired/code-discipline-config": "^0.1.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "bootstrap",
    "lifecycle",
    "shutdown",
    "backend",
    "bun",
    "dependency-injection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/bootstrap"
  },
  "homepage": "https://github.com/Trebired/bootstrap#readme",
  "bugs": {
    "url": "https://github.com/Trebired/bootstrap/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
