{
  "name": "@trebired/bootstrap",
  "version": "1.2.0",
  "description": "Generic application lifecycle orchestrator with ordered bootstrap discovery, readiness control, graceful degradation, and shutdown.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/prepare-dist.mjs prepare-dist",
    "demo": "bun run examples/dummy.ts",
    "postpack": "node ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && node ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:runtime && bun run verify:pack",
    "typecheck": "tsc --noEmit",
    "verify:runtime": "node ./scripts/verify/runtime.mjs",
    "verify:pack": "node ./scripts/verify/pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.2.5",
    "@package/result": "npm:@trebired/result@^1.1.1"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^4.7.3",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "bootstrap",
    "lifecycle",
    "shutdown",
    "backend",
    "node",
    "bun",
    "dependency-injection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/bootstrap"
  },
  "homepage": "https://github.com/Trebired/bootstrap#readme",
  "bugs": {
    "url": "https://github.com/Trebired/bootstrap/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
